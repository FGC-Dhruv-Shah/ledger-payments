# Copy to `.env` and fill in real values for local development.
# Never commit a populated .env file.

MERIDIAN_ENVIRONMENT=development
MERIDIAN_DATABASE_PATH=ledger.db
MERIDIAN_LOG_LEVEL=INFO

# Required. Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
MERIDIAN_SECRET_KEY=replace-with-a-strong-random-value
